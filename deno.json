{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.8",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2.45.0"
  },
  "tasks": {
    "test": "CLAUDE_AGENT_NO_BROKER=1 deno test --allow-env --allow-net --allow-read=supabase/functions,scripts supabase/functions/ scripts/",
    "test:db": "RUN_DB_TESTS=1 deno test --allow-env --allow-net supabase/functions/_shared/db.test.ts",
    "fmt": "deno fmt supabase/functions/ scripts/",
    "fmt:check": "deno fmt --check supabase/functions/ scripts/",
    "lint": "deno lint supabase/functions/ scripts/"
  },
  "fmt": { "lineWidth": 100 }
}
