# Local config for scripts/render_weekly_journal.ts -- the operator-run
# weekly-review journal renderer (#481, batch #478 Package C). Copy this
# file to .env.weekly (gitignored) and fill in the values, then run with:
#   deno run --allow-env --allow-net --allow-write=docs/trading-journal \
#     --env-file=.env.weekly scripts/render_weekly_journal.ts
# See docs/runbooks/weekly-review.md for the full procedure.
#
# DB-only equity sourcing (D3): this script never reads ALPACA_* -- only
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are needed, same as
# scripts/backfill_equity_snapshots.ts's Supabase half.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
