# Local config for scripts/backfill_equity_snapshots.ts — the one-time,
# operator-run backfill of equity_snapshots from Alpaca's portfolio-history
# (#389). Copy this file to .env.backfill (gitignored) and fill in the
# values, then run with:
#   deno run --allow-env --allow-net --env-file=.env.backfill \
#     scripts/backfill_equity_snapshots.ts [--since YYYY-MM-DD] [--execute]
# See docs/runbooks/equity-backfill.md for the one-time setup and full usage.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
