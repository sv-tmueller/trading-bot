# HTTP Basic Auth for the whole dashboard (server-side only — never NEXT_PUBLIC_).
# REQUIRED: the middleware fails closed — with DASHBOARD_PASSWORD unset, every
# request gets a 503 ("dashboard auth not configured") instead of data.
DASHBOARD_USER=your-dashboard-user
DASHBOARD_PASSWORD=your-dashboard-password

# Supabase project to read (server-side only — never exposed to the browser).
# For the paper soak, point at dev (qdaxxsuicyiscdvsdowc); at go-live, prod.
SUPABASE_URL=https://qdaxxsuicyiscdvsdowc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Alpaca keys for the "Holdings" panel (live equity + positions).
# The dashboard only issues GET requests, but Alpaca keys are UNSCOPED
# full-trading keys — treat them as trading credentials. Server-side only.
# Omit them and the panel shows a "not connected" hint instead.
# Use the SAME paper keys as the bot during the soak; switch to live keys at go-live.
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_PAPER=true
