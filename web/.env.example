# Supabase project to read (server-side only — never exposed to the browser).
# For the paper soak, point at dev (qdaxxsuicyiscdvsdowc); at go-live, prod.
SUPABASE_URL=https://qdaxxsuicyiscdvsdowc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Alpaca READ-ONLY keys for the "Holdings" panel (live equity + positions).
# Server-side only. Omit them and the panel shows a "not connected" hint instead.
# Use the SAME paper keys as the bot during the soak; switch to live keys at go-live.
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_PAPER=true

# Optional auth gate — DEFAULT-OFF. When set (format "user:pass"), the dashboard
# requires HTTP Basic auth before exposing account financials. Leave UNSET during
# the open paper soak; SET it as the go-live step before pointing at live/prod keys.
# DASHBOARD_BASIC_AUTH=admin:choose-a-strong-password
