ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ANTHROPIC_API_KEY=your_anthropic_key_here
TRADING_MODE=paper
TRADING_PAUSED=false
DATA_FEED=iex
RISK_PER_TRADE=0.01
DAILY_DRAWDOWN_LIMIT=0.03
MAX_POSITIONS=5
MAX_HOLD_DAYS=5
RR_RATIO_MIN=2.0
MAX_PORTFOLIO_EXPOSURE=0.20
STRICT_CROSSOVER=true
RSI_LOWER=40
RSI_UPPER=60
VOLUME_MULTIPLIER=1.5
ATR_STOP_MULTIPLIER=1.5
TRAILING_STOP_ENABLED=false
TRAILING_STOP_ATR_MULT=1.5
EARNINGS_BLACKOUT_DAYS=0
# place_market_order polls Alpaca for the parent fill_avg_price (#132) before submitting the OCO bracket
# children anchored to it (#133). _TIMEOUT_S = how long to wait before falling back to the pre-order quote;
# _INTERVAL_S = poll cadence within the timeout window.
FILL_POLL_TIMEOUT_S=10
FILL_POLL_INTERVAL_S=0.5
CLAUDE_MODEL=claude-sonnet-4-6
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trading-bot-notify
# Mechanical safety guard for agent-context broker calls (#168). Set to 1 in
# Engineer/QA subagent contexts to block tools/broker.py submission helpers
# (place_market_order, place_parent_market_order, place_oco_brackets,
# cancel_all_orders, liquidate_all_positions) from reaching live Alpaca —
# they raise BrokerCallBlockedError instead. Production cron leaves this UNSET.
# pytest sets it via an autouse conftest fixture so any forgotten mock fails fast.
CLAUDE_AGENT_NO_BROKER=
