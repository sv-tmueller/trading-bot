TRADING_PAUSED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trading-bot-notify
# Mechanical safety guard for agent-context broker calls (#168). Set to 1 in
# Engineer/QA subagent contexts to block tools/ibkr_broker.py submission
# helpers (place_market_order, liquidate, cancel_all_orders, connect_ibkr)
# from reaching live IBKR — they raise BrokerCallBlockedError instead.
# Production cron leaves this UNSET. pytest sets it via an autouse conftest
# fixture so any forgotten mock fails fast.
CLAUDE_AGENT_NO_BROKER=

# --- IBKR connection ---------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4002         # 4002=paper, 4001=live
IBKR_CLIENT_ID=1

# --- Bot strategy parameters --------------------------------------------
BOT_TICKER=WSPL.DE     # 3USL UCITS on Xetra
BOT_BENCHMARK=SPY
REGIME_SMA_DAYS=200
KILL_SWITCH_DRAWDOWN_PCT=0.25
KILL_SWITCH_LOOKBACK_DAYS=30

# Soak-mode: when true, daily_check.py runs the full pipeline but skips
# all broker writes (place_market_order, liquidate). Used for the soak
# week before flipping cron live. CLI --dry-run still wins. Default: false.
# DAILY_CHECK_DRY_RUN=false
