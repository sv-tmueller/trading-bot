# --- IBKR connection ---------------------------------------------------
IBKR_HOST=127.0.0.1                # TWS / IB Gateway host
IBKR_PORT=4002                     # 4002=paper, 4001=live
IBKR_CLIENT_ID=1                   # Connection client ID (any int 0-999)

# --- Bot strategy parameters ------------------------------------------
BOT_TICKER=WSPL.DE                 # The instrument the bot trades (3x leveraged ETF)
BOT_BENCHMARK=SPY                  # The instrument used for the regime decision
REGIME_SMA_DAYS=200                # SMA window for the regime decision
KILL_SWITCH_DRAWDOWN_PCT=0.25      # Drawdown from 30-day high that triggers kill switch (0.05 - 0.50)
KILL_SWITCH_LOOKBACK_DAYS=30       # Trading-day window for the rolling high (5 - 252)

# --- Notifications -----------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trading-bot-notify   # Discord notification webhook (silently skipped if unset)

# --- Operational kill switches ----------------------------------------
TRADING_PAUSED=false               # Halt new entries; daily_check.py exits before contacting IBKR
DAILY_CHECK_DRY_RUN=false          # Soak mode — daily_check.py runs full pipeline but skips broker writes
