ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ANTHROPIC_API_KEY=your_anthropic_key_here
TRADING_MODE=paper
TRADING_PAUSED=false
DATA_FEED=iex
RISK_PER_TRADE=0.01
DAILY_DRAWDOWN_LIMIT=0.03
MAX_POSITIONS=5
MAX_HOLD_DAYS=5
RR_RATIO_MIN=2.0
MAX_PORTFOLIO_EXPOSURE=0.20
STRICT_CROSSOVER=true
RSI_LOWER=40
RSI_UPPER=60
VOLUME_MULTIPLIER=1.5
ATR_STOP_MULTIPLIER=1.5
TRAILING_STOP_ENABLED=false
TRAILING_STOP_ATR_MULT=1.5
EARNINGS_BLACKOUT_DAYS=0
# How long place_market_order polls for the parent fill before falling back to the pre-order quote (#132).
FILL_POLL_TIMEOUT_S=10
FILL_POLL_INTERVAL_S=0.5
CLAUDE_MODEL=claude-sonnet-4-6
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trading-bot-notify
