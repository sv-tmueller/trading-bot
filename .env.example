# The production bot runs on Supabase Edge Functions. These are NOT loaded from a
# local .env — set them on the project with `supabase secrets set KEY=value ...`.
# This file is a reference list of the secrets the functions read. See
# docs/runbooks/mvp2-deploy-and-decommission.md for the full deploy steps and
# docs/CURRENT_CONFIG.md for the current deployed values.

# --- Alpaca (broker + market data) ------------------------------------
ALPACA_API_KEY=                    # Alpaca broker + data key
ALPACA_SECRET_KEY=                 # Alpaca broker + data secret
ALPACA_PAPER=true                  # true=paper, false=live
ALPACA_DATA_FEED=iex               # iex (default, free) or sip (live-feed; set via supabase secrets set)

# --- Bot strategy parameters ------------------------------------------
BOT_TICKER=UPRO                    # The instrument the bot trades (3x leveraged S&P 500 ETF)
BOT_BENCHMARK=SPY                  # The instrument used for the regime decision
REGIME_SMA_DAYS=200                # SMA window for the regime decision (20 - 500)
KILL_SWITCH_DRAWDOWN_PCT=0.25      # Drawdown from rolling high that triggers kill switch (0.05 - 0.50)
KILL_SWITCH_LOOKBACK_DAYS=30       # Trading-day window for the rolling high (5 - 252)

# --- Hourly-check bot parameters (#475, spec docs/superpowers/specs/2026-07-27-hourly-bot-design.md) ---
HOURLY_BOT_TICKER=SPY              # The instrument the hourly bot trades (separate from BOT_TICKER, the retired daily bot)
SIZING_RISK_PCT=0.01               # Risk budget per trade as a fraction of equity (0 - 0.05]; upper bound only; never binds on SPY hourly stops -- SIZING_NOTIONAL_CAP_PCT is the operative sizer (#499)
SIZING_NOTIONAL_CAP_PCT=0.10       # Notional cap per position as a fraction of equity (0 - 1.0]; operative sizer for SPY (#499)
HOURLY_BRACKET_R_MULTIPLE=2        # Bracket target = entry +/- R x stopDistance; fixed at 2 for v1 (spec revision required to change)
HOURLY_STOP_BUFFER_PCT=0.05        # Stop buffer as a fraction of the signal bar's range (0 - 0.5]
HOURLY_MIN_STOP_DISTANCE=0.05      # Minimum |entryRef - stopPrice| in USD; below this -> skipped:geometry_invalid
HOURLY_MAX_ENTRIES_PER_DAY=3       # Max new entries per symbol per day (1 - 10)
HOURLY_STALENESS_TOLERANCE_MIN=10  # Minutes past a completed bar's end before it's stale (1 - 60); coupled to the cron minute pin
HOURLY_CONTEXT_MODE=none           # none | reversal | continuation (§5)
HOURLY_SHORTS_ENABLED=false        # Short entries; fail-closed, unset means off. Only an explicit "true" enables
                                   # them; a blank or unparseable value throws at function start (#493)
HOURLY_BOT_PAPER_ONLY=true         # MUST be "true" -- the mechanical paper-only gate; unset or false throws at function start

# --- Operator kill button ---------------------------------------------
PANIC_TOKEN=                       # x-panic-token header value for the panic Edge Function

# --- Status endpoint ----------------------------------------------------
STATUS_TOKEN=                      # x-status-token header value for the read-only status Edge Function
                                   # (see docs/runbooks/status-check.md; validated by config.ts, no default)

# --- Notifications -----------------------------------------------------
NOTIFY_WEBHOOK_URL=                # Discord incoming-webhook URL (optional; skipped if unset, logged via console.warn).
                                   # Must be reachable from Supabase's cloud — a localhost URL will not work.

# --- Runtime pause (NOT a secret) -------------------------------------
# The operational pause flag lives in the bot_config DB row (key='paused'),
# toggled via the panic Edge Function (action=pause|resume) — not an env var.

# --- Dashboard (web/) -------------------------------------------------
# The read-only Next.js dashboard has its own env file: see web/.env.example
# (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY — server-side only).
