# The production bot runs on Supabase Edge Functions. These are NOT loaded from a
# local .env — set them on the project with `supabase secrets set KEY=value ...`.
# This file is a reference list of the secrets the functions read. See
# docs/runbooks/mvp2-deploy-and-decommission.md for the full deploy steps and
# docs/CURRENT_CONFIG.md for the current deployed values.

# --- Alpaca (broker + market data) ------------------------------------
ALPACA_API_KEY=                    # Alpaca broker + data key
ALPACA_SECRET_KEY=                 # Alpaca broker + data secret
ALPACA_PAPER=true                  # true=paper, false=live

# --- Bot strategy parameters ------------------------------------------
BOT_TICKER=UPRO                    # The instrument the bot trades (3x leveraged S&P 500 ETF)
BOT_BENCHMARK=SPY                  # The instrument used for the regime decision
REGIME_SMA_DAYS=200                # SMA window for the regime decision (20 - 500)
KILL_SWITCH_DRAWDOWN_PCT=0.25      # Drawdown from rolling high that triggers kill switch (0.05 - 0.50)
KILL_SWITCH_LOOKBACK_DAYS=30       # Trading-day window for the rolling high (5 - 252)

# --- Operator kill button ---------------------------------------------
PANIC_TOKEN=                       # x-panic-token header value for the panic Edge Function

# --- Notifications -----------------------------------------------------
N8N_WEBHOOK_URL=                   # Discord notification webhook (optional; silently skipped if unset).
                                   # Must be reachable from Supabase's cloud — a localhost URL will not work.

# --- Runtime pause (NOT a secret) -------------------------------------
# The operational pause flag lives in the bot_config DB row (key='paused'),
# toggled via the panic Edge Function (action=pause|resume) — not an env var.

# --- Dashboard (web/) -------------------------------------------------
# The read-only Next.js dashboard has its own env file: see web/.env.example
# (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY — server-side only).
