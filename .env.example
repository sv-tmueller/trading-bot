ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
TRADING_MODE=paper
TRADING_PAUSED=false
DATA_FEED=iex
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trading-bot-notify
# Mechanical safety guard for agent-context broker calls (#168). Set to 1 in
# Engineer/QA subagent contexts to block tools/broker.py submission helpers
# (place_market_order, place_parent_market_order, place_oco_brackets,
# cancel_all_orders, liquidate_all_positions) from reaching live Alpaca —
# they raise BrokerCallBlockedError instead. Production cron leaves this UNSET.
# pytest sets it via an autouse conftest fixture so any forgotten mock fails fast.
CLAUDE_AGENT_NO_BROKER=
# --- IBKR connection (replaces Alpaca) ----------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4002         # 4002=paper, 4001=live
IBKR_CLIENT_ID=1

# --- Bot strategy parameters --------------------------------------------
BOT_TICKER=WSPL.DE     # 3USL UCITS on Xetra
BOT_BENCHMARK=SPY
REGIME_SMA_DAYS=200
KILL_SWITCH_DRAWDOWN_PCT=0.25
KILL_SWITCH_LOOKBACK_DAYS=30

# Soak-mode: when true, daily_check.py runs the full pipeline but skips
# all broker writes (place_market_order, liquidate). Used for the soak
# week before flipping cron live. CLI --dry-run still wins. Default: false.
# DAILY_CHECK_DRY_RUN=false
